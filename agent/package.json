  "description": "Off-chain AI agent that computes fair price for illiquid RWA, generates TEE attestation mock, and registers it on-chain with FluxaHook",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "serve": "tsx src/index.ts --serve",
