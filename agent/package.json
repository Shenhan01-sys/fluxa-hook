    "register": "tsx src/index.ts --register",
    "build-hookdata": "tsx src/index.ts --hookdata"
  },
  "dependencies": {
    "viem": "^2.21.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.5.0"
  }
}
