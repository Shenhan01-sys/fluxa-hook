# Fluxa Agent Service environment
# Copy to .env and fill in. All fields optional — service falls back to mock mode.

# LLM Provider: "groq" | "mock" (default: groq)
LLM_PROVIDER=groq

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Groq model: llama-3.3-70b-versatile | llama-3.1-8b-instant | openai/gpt-oss-20b
GROQ_MODEL=llama-3.3-70b-versatile

# Chain config (Base Sepolia defaults — already deployed)
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Deployer private key (same as fluxa-hook/.env, used to register attestation on-chain)
# REQUIRED if running --register; optional otherwise
PRIVATE_KEY=

# v4 deployed contract addresses (Base Sepolia)
FLUXA_HOOK=0x4739EB6F614e68f9895608ba00DAA2f286B39aC8
CHRONICLE_ORACLE=0x497CB366F87E6dbE2661B84A74FC8D0e3b9Ce78F
REPUTATION_REGISTRY=0x61cd0a0031741844436dc5Dd5e7b92e75FD0Fba3
AGENT_NFT=0x5631e19672112F2feAa43C98Cc86A93a349f498a
AVS_VALIDATOR=0x9d234C700D19C10a4ed6939d7fE04D0975d4ef78
ESCROW=0x2d500728984c454783209F5a4616Cb7F9076EABD
RWA_TOKEN=0x6cd15B8D866F8b19ea9310fD662809Dd7449bB81
AGENT_ID=1

# RWA instrument metadata for LLM prompt
RWA_NAME=Fluxa RWA Bond
RWA_SYMBOL=FRWA
RWA_DESCRIPTION=Tokenized private credit instrument backed by real-world asset pool (invoice receivables). Illiquid, no public market.
RWA_LAST_PRICE=1.0
RWA_LAST_PRICE_TS=1724592000
